        "from sklearn.metrics import r2_score\n",
        "import numpy as np\n",
        "\n",
        "# Correlação de Pearson (R)\n",
        "correlacao_matriz = df[['Temperature', 'Revenue']].corr()\n",
        "r_pearson = correlacao_matriz.loc['Temperature', 'Revenue']\n",
        "\n",
        "# Coeficiente de Determinação (R²) usando o modelo treinado anteriormente\n",
        "y_pred = model.predict(X)\n",
        "r2 = r2_score(y, y_pred)\n",
        "\n",
        "print(f\"Coeficiente de Correlação (R de Pearson): {r_pearson:.6f}\")\n",
        "print(f\"Coeficiente de Determinação (R²): {r2:.6f}\")\n",
