      "source": [
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "# Prepara as variáveis X (independente) e y (dependente)\n",
        "X = df[['Temperature']]\n",
        "y = df['Revenue']\n",
        "\n",
        "# Cria e ajusta o modelo de regressão linear\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Obtém os coeficientes\n",
        "inclinacao = model.coef_[0]\n",
        "intercepto = model.intercept_\n",
        "\n",
        "print(f\"Coeficiente Angular (Inclinação / Slope): {inclinacao:.4f}\")\n",
        "print(f\"Coeficiente Linear (Intercepto / Intercept): {intercepto:.4f}\")\n",
        "print(f\"\\nEquação da Reta: Revenue = {inclinacao:.4f} * Temperature + ({intercepto:.4f})\")"
      ],
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Coeficiente Angular (Inclinação / Slope): 21.4420\n",
            "Coeficiente Linear (Intercepto / Intercept): 44.2968\n",
            "\n",
            "Equação da Reta: Revenue = 21.4420 * Temperature + (44.2968)\n"
          ]
