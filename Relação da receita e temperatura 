      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Configura o estilo do gráfico\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Cria a figura\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# Desenha o gráfico de dispersão com a linha de regressão linear\n",
        "sns.regplot(\n",
        "    data=df,\n",
        "    x='Temperature',\n",
        "    y='Revenue',\n",
        "    scatter_kws={'alpha': 0.6, 'color': 'royalblue'},\n",
        "    line_kws={'color': 'darkred', 'linewidth': 2}\n",
        ")\n",
        "\n",
        "# Títulos e rótulos\n",
        "plt.title('Relação entre Temperatura e Faturamento de Vendas de Sorvete', fontsize=14, pad=15)\n",
        "plt.xlabel('Temperatura (°C)', fontsize=12)\n",
        "plt.ylabel('Faturamento (Revenue)', fontsize=12)\n",
        "\n",
        "# Exibe o gráfico\n",
        "plt.show()"
